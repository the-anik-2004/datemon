generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum Category {
  PERSONAL
  BILL
  APPOINTMENT
  WORK
  STUDY
  HEALTH
  RENEWAL
  BIRTHDAY
  OTHER
}

enum ReminderStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum RecurrenceType {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum Platform {
  ANDROID
  IOS
}

// ============================================
// MODELS
// ============================================

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  name          String
  timezone      String   @default("UTC")
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reminders     Reminder[]
  notifications Notification[]
  devices       Device[]
  refreshTokens RefreshToken[]
  otps          EmailOtp[]
}

model Reminder {
  id             String          @id @default(uuid())
  userId         String
  title          String
  description    String?
  scheduledAt    DateTime
  priority       Priority        @default(NORMAL)
  category       Category        @default(OTHER)
  status         ReminderStatus  @default(ACTIVE)
  recurrenceType RecurrenceType  @default(NONE)
  recurrenceData Json?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([userId, status])
  @@index([userId, scheduledAt])
}

model Notification {
  id          String             @id @default(uuid())
  userId      String
  reminderId  String
  scheduledAt DateTime
  sentAt      DateTime?
  status      NotificationStatus @default(PENDING)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminder Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([reminderId])
}

model Device {
  id        String   @id @default(uuid())
  userId    String
  pushToken String   @unique
  platform  Platform
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailOtp {
  id         String    @id @default(uuid())
  userId     String
  otpHash    String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
}